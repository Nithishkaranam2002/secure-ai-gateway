OPENAI_API_KEY=sk-your-key-here
GROQ_API_KEY=gsk-your-key-here
JWT_SECRET=change-me-in-production
DATABASE_PATH=data/gateway.db
PRIMARY_BASE_URL=https://api.openai.com/v1
BACKUP_BASE_URL=https://api.groq.com/openai/v1
PRIMARY_MODEL=gpt-4o-mini
BACKUP_MODEL=allam-2-7b
RATE_LIMIT_TOKENS_PER_MINUTE=50000
UPSTREAM_TIMEOUT_MS=3000
LOG_LEVEL=INFO
MCP_GATEWAY_URL=http://127.0.0.1:8000
# Lower this on a public deployment. 2000 is enough to demonstrate the limiter
# without giving an anonymous visitor a large budget to spend.
SEED_TOKEN_LIMIT=50000
